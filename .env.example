# Checklist lead delivery. Set these in the Vercel project environment.
# Leave the values empty here. Never commit real keys or addresses.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives checklist leads (for example sales@govistudio.com)
LEAD_TO_EMAIL=

# Verified sender on the Resend domain (for example leads@govistudio.com)
LEAD_FROM_EMAIL=
